# Energy Forecast API Configuration
# Copy this to .env and update values

# Application
DEBUG=true
APP_NAME="Energy Forecast API"
APP_VERSION="1.0.0"

# Database
# SQLite for development
DATABASE_URL=sqlite+aiosqlite:///./data/energy_forecast.db
# PostgreSQL for production
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/energy_forecast

# Data Sources
AEMO_BASE_URL=https://aemo.com.au/aemo/data/nem/priceanddemand
AEMO_API_URL=https://visualisations.aemo.com.au/aemo/apps/api/report/5MIN

# Optional: Weather API (OpenWeatherMap)
# Get free API key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Optional: US Energy Information Administration
# Get free API key at https://www.eia.gov/opendata/
EIA_API_KEY=

# Scheduler Settings
FETCH_INTERVAL_MINUTES=30
MODEL_RETRAIN_HOURS=24

# ML Settings
MODEL_PATH=data/models
LOOKBACK_HOURS=168
FORECAST_HORIZON_HOURS=24

# CORS Origins (comma-separated for production)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
